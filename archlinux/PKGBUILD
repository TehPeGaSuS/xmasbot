# Maintainer: 2017 ugjka <esesmu@protonmail.com>

_pkgname=xmasbot
pkgname="$_pkgname-git"
pkgver=20221231.8f6cb5c
pkgrel=1
pkgdesc='Merry Christmas Irc Party Bot'
arch=('x86_64')
url="https://github.com/TehPeGaSuS/${_pkgname}"
license=('MIT')
depends=('gtk3' 'glib2')
makedepends=('go' 'go-tools' 'git' 'make')
source=("$_pkgname"::"git+https://github.com/ThePeGaSuS/${_pkgname}.git")
md5sums=('SKIP')

pkgver() {
    cd $_pkgname
    echo "$(git log -1 --format="%cd" --date=short | tr -d '-').$(git log -1 --format="%h")"
}
build(){
    cd $_pkgname
    make prefix=/usr all
}

package(){
    cd $_pkgname
    make prefix="${pkgdir}"/usr install
    make clean
}
